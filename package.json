{
  "publisher": "SHI-IT",
  "name": "dev-helper",
  "displayName": "XPlatform 통합 개발팩",
  "description": "XPlatform 개발을 위한 VS Code 확장 통합팩",
  "version": "2.1.5",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionDependencies": [
    "vscjava.vscode-java-pack"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dev-helper.showSettings",
        "title": "Show Settings Panel",
        "category": "XPlatform"
      },
      {
        "command": "dev-helper.includeInSHIDeployTarget",
        "title": "SHI 배포대상 추가/제거",
        "category": "XPlatform"
      },
      {
        "command": "dev-helper.analyzeReference",
        "title": "SHI: 참조관계 분석",
        "category": "XPlatform"
      },
      {
        "command": "dev-helper.toggleLocalGitIgnore",
        "title": "XPlatform: 로컬 Git 무시 토글 (skip-worktree)",
        "category": "XPlatform"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xplatform-sidebar",
          "title": "XPlatform 개발환경 관리",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "xplatform-sidebar": [
        {
          "type": "webview",
          "id": "dev-helper.settingsView",
          "name": "",
          "contextualTitle": "XPlatform 개발환경 관리"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "dev-helper.includeInSHIDeployTarget",
          "when": "resourcePath =~ /.*[\\\\\\/]src[\\\\\\/](java|query)[\\\\\\/].*/",
          "group": "z_commands@1"
        },
        {
          "command": "dev-helper.toggleLocalGitIgnore",
          "when": "!explorerResourceIsFolder",
          "group": "z_commands@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "dev-helper.includeInSHIDeployTarget",
          "when": "resourcePath =~ /.*[\\\\\\/]src[\\\\\\/](java|query)[\\\\\\/].*/",
          "group": "z_commands@1"
        },
        {
          "command": "dev-helper.toggleLocalGitIgnore",
          "group": "z_commands@2"
        }
      ],
      "editor/context": [
        {
          "command": "dev-helper.analyzeReference",
          "when": "resourceExtname == .java && resourcePath =~ /.*[\\\\\\/]src[\\\\\\/]java[\\\\\\/].*/",
          "group": "z_shi_commands@1"
        }
      ]
    },
    "configuration": {
      "title": "shi-it-dev-env",
      "properties": {
        "shiDevHelper.allValidated": {
          "type": "boolean",
          "description": "XPlatform 개발환경 설정 기존 검증 여부"
        },
        "shiDevHelper.gradlePath": {
          "type": "string",
          "description": "Gradle 경로"
        },
        "shiDevHelper.jdkPath": {
          "type": "string",
          "description": "JDK 경로"
        },
        "shiDevHelper.tomcatPath": {
          "type": "string",
          "description": "Tomcat 경로"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "compile": "tsc -p ./",
    "compile:webview": "cd ui && npm install && npm run build",
    "build:all": "npm run compile && npm run compile:webview",
    "watch": "tsc -watch -p ./",
    "watch:webview": "cd ui && npm run dev",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"ui/src/**/*.{ts,tsx}\"",
    "test": "jest"
  },
  "dependencies": {
    "@vscode/vsce": "^3.7.1",
    "cpy": "^13.2.1",
    "fs-extra": "^11.3.3",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.39",
    "@types/vscode": "~1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.0"
  }
}
